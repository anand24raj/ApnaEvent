# Reference only: Spring Boot does not automatically load this file.
# Export these variables in your shell/IDE run configuration, or use a trusted
# local environment loader. Never commit a real .env file.
# Replace every placeholder before starting the application.
# Use the SAME randomly generated JWT_SECRET for Auth-Service, ApiGateway, and RA-AI-Service.
# JWT_SECRET must contain at least 32 characters; use a unique random value.

JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

AUTH_USERNAME=admin
AUTH_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_ADMIN_PASSWORD

DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAIL_APP_PASSWORD_IF_EMAIL_IS_ENABLED
MAIL_FROM=ApnaEvent <noreply@apnaevent.com>

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

CONFIG_GIT_URI=https://github.com/anand24raj/ApnaEvent.git
CONFIG_GIT_LABEL=main